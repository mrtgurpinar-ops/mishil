# App Config
APP_NAME=mishil
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security / JWT
JWT_SECRET=super_secret_jwt_key_for_mishil_app_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days for mobile app session

# Database (PostgreSQL)
DATABASE_URL=postgresql://mishil_user:mishil_password@localhost:5432/mishil_db

# RevenueCat / Subscriptions
REVENUECAT_WEBHOOK_SECRET=rc_webhook_secret_example_key

# Audio Constraints
MAX_AUDIO_UPLOAD_SIZE_BYTES=10485760  # 10 MB in bytes
ALLOWED_AUDIO_MIME_TYPES=audio/wav,audio/x-wav,audio/m4a,audio/x-m4a,audio/mpeg,audio/mp3

# Push Notification Mock / Keys (FCM/APNs)
FCM_SERVER_KEY=mock_fcm_server_key_optional
